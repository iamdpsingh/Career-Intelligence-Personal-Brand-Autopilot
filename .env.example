# ==============================================================================
# ENVIRONMENT CONFIGURATION (Rule 36: Free-Tier Operation)
# ==============================================================================
# WARNING: Do NOT commit .env to version control.
# Only commit this .env.example file.

# ------------------------------------------------------------------------------
# 1. AI PROVIDERS (Rule 18, 36)
# ------------------------------------------------------------------------------
# We support multiple providers to control costs and avoid rate limits.
# At least one must be provided.
OPENAI_API_KEY="sk-proj-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GROQ_API_KEY="gsk_..."

# NVIDIA API for Image Generation (V2)
NVIDIA_API_KEY="nvapi-..."

# Set limits to enforce Rule 36 (Free tier operation)
MAX_AI_SPEND_PER_MONTH_USD=2.00

# ------------------------------------------------------------------------------
# 2. DATABASE (Rule 23)
# ------------------------------------------------------------------------------
# Local SQLite Database (Local-first architecture)
DATABASE_URL="./local.db"

# ------------------------------------------------------------------------------
# 3. CRON SECURITY (Rule 03, 33)
# ------------------------------------------------------------------------------
# Vercel provides this automatically in production, but you can set it manually
# for local testing of the cron route.
CRON_SECRET="your_secure_random_string_here"

# ------------------------------------------------------------------------------
# 4. GITHUB APP & TOKENS (V2)
# ------------------------------------------------------------------------------
# For local daemon runs without DB OAuth flow, provide a Personal Access Token:
GITHUB_TOKEN=""

# GitHub OAuth App credentials (if hosting the UI for other users):
# GITHUB_CLIENT_ID="..."
# GITHUB_CLIENT_SECRET="..."

# ------------------------------------------------------------------------------
# 5. LINKEDIN APP (V2)
# ------------------------------------------------------------------------------
# Used when publishing approved drafts (Rule 61)
# LINKEDIN_CLIENT_ID="..."
# LINKEDIN_CLIENT_SECRET="..."


